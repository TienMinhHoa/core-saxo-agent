# FastAPI backend runtime. Values are validated at startup.
SAXO_DATA_ROOT=runtime/saxophone
SAXO_CHROMA_PERSIST_DIRECTORY=runtime/saxophone/chroma
SAXO_CHROMA_COLLECTION_NAME=saxophone_chunks
SAXO_CHROMA_CONCEPT_COLLECTION_NAME=concept_catalog
SAXO_EMBEDDING_DIMENSION=1536
SAXO_MAX_UPLOAD_BYTES=209715200

# Required external model service. Use HTTPS and keep the token out of Git.
SAXO_REMOTE_GPU_BASE_URL=https://model-service.example.com
SAXO_REMOTE_GPU_BEARER_TOKEN=
SAXO_LITELLM_ENDPOINT=https://model-service.example.com/v1/invoke
SAXO_LITELLM_MODEL_PROFILE=saxophone-default
SAXO_LITELLM_STRUCTURED_OUTPUT_MODE=json_schema
SAXO_REMOTE_GPU_TLS_VERIFY=true

# PDF layout: Paddle client runs layout stages on backend CPU and sends VL
# recognition requests to this vLLM OpenAI-compatible endpoint.
SAXO_PADDLE_VLLM_SERVER_URL=http://paddle-vllm-host:8000/v1

# Optional resilience settings.
SAXO_REMOTE_GPU_HEALTH_TIMEOUT_SECONDS=5
SAXO_LITELLM_TIMEOUT_SECONDS=30
SAXO_LITELLM_MAX_ATTEMPTS=1
SAXO_LITELLM_RETRY_BACKOFF_SECONDS=0
