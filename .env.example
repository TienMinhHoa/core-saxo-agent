# Catalog chỉ chứa dữ liệu đã import/duyệt; không dùng thư mục docs/extracted làm catalog.
MUSIC_RAG_CATALOG=runtime/music-theory-demo
MUSIC_RAG_ACCESS_SCOPE=public

# Gradio Share tạm thời: không cần API key.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=true

# Copy file này thành .env rồi điền key. Bắt buộc để build/query semantic index.
# Key chỉ được backend đọc, không bao giờ gửi xuống trình duyệt.
OPENAI_API_KEY=
MUSIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
# ChromaDB persistence for the header-chunk index (separate from the legacy catalog).
MUSIC_RAG_CHROMA_DIR=runtime/chroma/music-theory-for-dummies
MUSIC_RAG_CHROMA_COLLECTION=music_theory_header_chunks
MUSIC_RAG_EMBEDDING_WORKERS=4
# Conservative per-chunk guard; chunks estimated above this are skipped.
MUSIC_RAG_EMBEDDING_MAX_INPUT_TOKENS=8000
# Optional override; default prices are defined for the built-in embedding models.
# MUSIC_RAG_EMBEDDING_PRICE_USD_PER_MILLION=0.02
# Agent chỉ chọn/rewrite query, không được phép sinh câu trả lời.
MUSIC_RAG_AGENT_MODEL=gpt-4.1-mini
# Số vòng retrieval gồm vòng đầu; chỉ nhận giá trị 1–4.
MUSIC_RAG_MAX_ROUNDS=4

# DeepSeek VLM cho figure enrichment. Không commit key thật vào .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Answer tab: canonical DeepSeek Flash model with thinking enabled by the app.
DEEPSEEK_ANSWER_MODEL=deepseek-flash
DEEPSEEK_ANSWER_REASONING_EFFORT=high
DEEPSEEK_ANSWER_MAX_TOKENS=4096
DEEPSEEK_ANSWER_MAX_IMAGES=8
# OCR hierarchy repair: full-document DeepSeek Flash labeling with max thinking.
DOCUMENT_STRUCTURE_MODEL=deepseek-flash
DOCUMENT_STRUCTURE_BATCH_SIZE=20
FIGURE_VLM_BASE_URL=https://api.deepseek.com
FIGURE_VLM_MODEL=deepseek-v4-flash-vision-exp
# Số request DeepSeek đồng thời; tăng dần sau khi smoke test thành công.
FIGURE_VLM_WORKERS=4

# Tùy chọn: điền cả hai để bật Basic Auth trước khi người khác vào giao diện.
# MUSIC_RAG_AUTH_USER=
# MUSIC_RAG_AUTH_PASSWORD=
