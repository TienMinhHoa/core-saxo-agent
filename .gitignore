# Secrets and local environment
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Test reports, logs, cache and temporary files
/test-artifacts/

# Virtual environments and uv cache
.venv/
venv/
env/
.uv-cache/
.codex/


# Packaging artifacts
build/
dist/
*.egg-info/

# Runtime state and generated extraction artifacts
/runtime/
/output/
/output_v*/
/.paddlex/
/src/.paddlex/
# Local documentation and agent traces
/docs/
/.gnhf/
/.codex/
.codex/
temp/
/temp/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
.pytest-tmp/
.pytest-tmp-*/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# The lockfile is part of the reproducible project state.
!uv.lock
